        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
            <Text text="{data>label}" class="sapUiTinyMarginEnd" />
            <Text text="{data>value}" fontDesign="Bold" />
        </HBox>
    </VBox>
</core:FragmentDefinition>
