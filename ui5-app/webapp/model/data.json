  "P2PSteps": [
    {
      "id": "step1",
      "title": "Requirement Identification",
      "desc": "The procurement process starts when a business unit identifies a need for materials or services.",
      "tcodes": ["ME51N", "ME52N", "ME53N"],
      "details": {
        "purpose": "Inform purchasing dept of material/service requirements",
        "internal": "Internal document, not sent to vendors",
        "types": [
          { "type": "NB", "label": "Standard PR" },
          { "type": "L", "label": "Subcontracting" },
          { "type": "K", "label": "Consignment" }
        ]
      }
    },
    {
      "id": "step2",
      "title": "Sourcing",
      "desc": "Identifying potential vendors and selecting the best source of supply.",
      "tcodes": ["ME41", "ME47", "ME49"],
      "details": {
        "purpose": "Evaluate vendors based on price, quality, and delivery",
        "methods": ["RFQ", "Quotation Maintenance", "Price Comparison"]
      }
    },
    {
      "id": "step3",
      "title": "Purchase Order",
      "desc": "A legally binding document sent to a vendor to buy materials/services.",
      "tcodes": ["ME21N", "ME22N", "ME23N"],
      "details": {
        "purpose": "External legal commitment",
        "types": ["Standard", "Blanket", "Release Order"]
      }
    },
    {
      "id": "step4",
      "title": "Goods Receipt",
      "desc": "Recording the physical arrival of goods from the vendor.",
      "tcodes": ["MIGO"],
      "details": {
        "purpose": "Updates stock levels and valuation",
        "mvt": "101 (Standard GR)"
      }
    },
    {
      "id": "step5",
      "title": "Invoice Verification",
      "desc": "Verifying the vendor's invoice against the PO and GR.",
      "tcodes": ["MIRO"],
      "details": {
        "purpose": "Ensures 3-way matching before payment",
        "match": "PO + GR + Invoice"
      }
    }
  ],
  "Integrations": [
    {
      "module": "MM-FI",
